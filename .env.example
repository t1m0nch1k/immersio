# Optional Azure Neural TTS fallback for Slovak.
# Keep the real key in .env (never commit it).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=sk-SK-ViktoriaNeural

# Edge-TTS is tried first for every language and uses Microsoft Neural Voices.
EDGE_TTS_PYTHON=python
EDGE_TTS_RATE=-12%
EDGE_TTS_EN_VOICE=en-US-EmmaNeural
EDGE_TTS_ES_VOICE=es-ES-ElviraNeural
EDGE_TTS_DE_VOICE=de-DE-KatjaNeural
EDGE_TTS_FR_VOICE=fr-FR-DeniseNeural
EDGE_TTS_IT_VOICE=it-IT-ElsaNeural
EDGE_TTS_JA_VOICE=ja-JP-NanamiNeural
EDGE_TTS_VOICE=sk-SK-ViktoriaNeural
EDGE_TTS_CS_VOICE=cs-CZ-VlastaNeural
