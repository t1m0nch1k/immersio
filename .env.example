# Optional Azure Neural TTS fallback for Slovak.
# Keep the real key in .env (never commit it).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=sk-SK-ViktoriaNeural

# Edge-TTS is tried first for every language and uses Microsoft Neural Voices.
EDGE_TTS_PYTHON=python
EDGE_TTS_RATE=-12%
EDGE_TTS_EN_VOICE=en-US-EmmaNeural
EDGE_TTS_ES_VOICE=es-ES-ElviraNeural
EDGE_TTS_DE_VOICE=de-DE-KatjaNeural
EDGE_TTS_FR_VOICE=fr-FR-DeniseNeural
EDGE_TTS_IT_VOICE=it-IT-ElsaNeural
EDGE_TTS_JA_VOICE=ja-JP-NanamiNeural
EDGE_TTS_VOICE=sk-SK-ViktoriaNeural
EDGE_TTS_CS_VOICE=cs-CZ-VlastaNeural

# --- Progress sync (Supabase) ---------------------------------------------
# Both are optional. With neither set, the app runs as a guest and never opens
# a connection: localStorage is the only store and the UI hides the sync panel.
#
# The anon key is not a secret — it is compiled into the web bundle and into the
# APK, so anybody can read it out of either. Row Level Security in
# supabase/schema.sql is the actual security boundary.
#
# Because they are build-time values, pointing the app at a different project or
# rotating the key means a new release. For the APK that means a new upload.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- api/tts.py hardening (all optional, safe defaults apply when unset) ---
# Comma-separated list of browser origins allowed to call the TTS proxy.
# Empty = no CORS headers are emitted at all (same-origin server calls keep
# working). Example: https://pogruzhenie.vercel.app,https://my-app.pages.dev
TTS_ALLOWED_ORIGINS=

# Per-IP sliding window rate limit for /api/tts.
# TTS_RATE_LIMIT_MAX requests per TTS_RATE_LIMIT_WINDOW_MS milliseconds.
# Defaults: 30 requests / 60000 ms.
TTS_RATE_LIMIT_MAX=30
TTS_RATE_LIMIT_WINDOW_MS=60000
